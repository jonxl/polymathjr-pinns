# macOS
.DS_Store

# editors
.vscode/

# generated plots / data dumps (regenerated by the scripts) -- keep .txt logs in data/
data/*.png
data/*.jpg
data/*.jpeg
data/*.gif
data/*.csv

# provisional / archived experiments -- keep local, not pushed
scripts/experimental/
scripts/archive/

# presentation drafts / binaries -- keep local (only README.md is tracked)
/*.md
!/README.md
*.html
*.key
